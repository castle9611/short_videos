{
  "name": "shiying-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "browser": {"binding": "BROWSER"},
  "assets": {"directory": "./web", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"ALLOWED_ORIGINS": "http://127.0.0.1:8080,http://localhost:8080,https://appassets.androidplatform.net"},
  "d1_databases": [{"binding": "DB", "database_name": "shiying-users", "database_id": "8b891307-3b71-4a61-8e91-2cee1977c2d9"}],
  "observability": {"enabled": true}
}
